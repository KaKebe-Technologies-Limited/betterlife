# ---------------------------------------------------------------
# BetterLife International — root .htaccess
# Performance + basic security headers (SEO cares about page speed).
# ---------------------------------------------------------------

# Compress text-based assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Long-lived caching for static assets, none for HTML (so content updates show immediately)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Hide dotfiles (.env, .git, etc.) from the web
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Developer files never belong on the public web. Visiting a migration would run it and reset the
# site's content; the database dumps include the admin account. Pages still load these folders
# from disk; only browsers are turned away.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(?:.*/)?(migrations|tools|database|design-preview|config|vendor|includes)(/|$)
</IfModule>
<FilesMatch "\.(sql|md|log|lock|sh|bak)$">
  Require all denied
</FilesMatch>

# Friendly 404s stay inside the site's own design
ErrorDocument 404 /404.php

# Clean addresses: /about, /programmes/<slug>, /projects/<slug>, /stories/<slug>, /shop/<slug>.
# Each is served by its PHP page; old .php links are sent on to these by includes/functions.php.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(about|team|partners|contact|farm|donate|privacy|safeguarding|checkout)/?$ $1.php [L,QSA]
  RewriteRule ^programmes/?$ programs.php [L,QSA]
  RewriteRule ^programmes/([a-z0-9-]+)/?$ program.php?slug=$1 [L,QSA]
  RewriteRule ^projects/?$ projects.php [L,QSA]
  RewriteRule ^projects/([a-z0-9-]+)/?$ project.php?slug=$1 [L,QSA]
  RewriteRule ^impact/?$ impact-reports.php [L,QSA]
  RewriteRule ^stories/?$ blog.php [L,QSA]
  RewriteRule ^stories/([a-z0-9-]+)/?$ blog-single.php?slug=$1 [L,QSA]
  RewriteRule ^shop/?$ products.php [L,QSA]
  RewriteRule ^shop/([a-z0-9-]+)/?$ product.php?slug=$1 [L,QSA]
  RewriteRule ^basket/?$ cart.php [L,QSA]
  RewriteRule ^order/([A-Za-z0-9-]+)/?$ order-confirmation.php?ref=$1 [L,QSA]
  RewriteRule ^donate/thank-you/([A-Za-z0-9-]+)/?$ donate-thanks.php?ref=$1 [L,QSA]
  # Admin pages: /admin/settings is admin/settings.php (when that file exists)
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^admin/([a-z-]+)$ admin/$1.php [L,QSA]
</IfModule>
