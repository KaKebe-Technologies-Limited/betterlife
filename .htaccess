# ---------------------------------------------------------------
# BetterLife International — root .htaccess
# Performance + basic security headers (SEO cares about page speed).
# ---------------------------------------------------------------

# Compress text-based assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Long-lived caching for static assets, none for HTML (so content updates show immediately)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Hide dotfiles (.env, .git, etc.) from the web
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Friendly 404s stay inside the site's own design
ErrorDocument 404 /404.php
